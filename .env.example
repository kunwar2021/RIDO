# ============================================================
# RIDO Logistics Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# MongoDB
# Local:  mongodb://localhost:27017/rido_logistics
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/rido_logistics
MONGODB_URI=mongodb://localhost:27017/rido_logistics

# File Uploads
UPLOAD_DIR=uploads

# Google Maps Platform (Routes API v2 + Tolls)
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable: Routes API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# Render (auto-injected by Render platform — do not set manually)
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
